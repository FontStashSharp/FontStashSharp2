<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FontStashSharp2</RootNamespace>
    <AssemblyName>FontStashSharp2</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>FontStashSharp2</PackageId>
    <Version>0.1.0</Version>
    <Authors>FontStashSharp2 contributors</Authors>
    <Description>On-demand TrueType text rendering for MonoGame, drawn through SpriteBatch.</Description>
    <PackageTags>monogame;font;truetype;text;spritebatch;stb_truetype;gamedev</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
    <PackageReference Include="StbTrueTypeNext" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\docfx\images\hello-world.png" Pack="true" PackagePath="docfx\images\" />
  </ItemGroup>

</Project>
