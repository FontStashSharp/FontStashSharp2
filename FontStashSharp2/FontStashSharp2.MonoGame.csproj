<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FontStashSharp2</RootNamespace>
    <DefineConstants>$(DefineConstants);MONOGAME</DefineConstants>
    <AssemblyName>FontStashSharp2</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>FontStashSharp2</PackageId>
    <Authors>FontStashSharp2 contributors</Authors>
    <Description>On-demand TrueType and static BMFont text rendering for MonoGame, drawn through SpriteBatch.</Description>
    <PackageTags>monogame;font;truetype;bmfont;bitmap-font;text;spritebatch;stb_truetype;gamedev</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!--
      PrivateAssets=All keeps MonoGame out of the package dependency graph so consumers can choose
      any compatible MonoGame backend (DesktopGL, WindowsDX, Android, iOS, etc.).
    -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" PrivateAssets="All" />
    <PackageReference Include="StbTrueTypeNext" Version="$(StbTrueTypeNextVersion)" />
    <PackageReference Include="SharpFNT" Version="$(SharpFNTVersion)" />
    <PackageReference Include="StbImageNext" Version="$(StbImageNextVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\docfx\images\hello-world.png" Pack="true" PackagePath="docfx\images\" />
  </ItemGroup>

</Project>
